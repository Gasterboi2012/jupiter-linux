# Maintainer: Jupiter Linux <maintainers@jupiter.example>
#
# Placeholder artwork sits next to this PKGBUILD (makepkg only finds local
# sources in the package directory). Replace logo.svg, logo-256.png,
# logo-512.png, logo.txt and wallpaper.png (see generate-assets.py), run
# `updpkgsums`, then rebuild; nothing else needs to know the artwork changed.

pkgname=jupiter-branding
pkgver=0.1.0
pkgrel=1
pkgdesc="Jupiter Linux branding: os-release, logo, wallpaper and desktop defaults"
arch=('any')
url="https://jupiter.example/"
license=('CC0-1.0')
install=jupiter-branding.install
source=(
    'os-release'
    'lsb-release'
    'issue'
    'logo.txt'
    'logo.svg'
    'logo-256.png'
    'logo-512.png'
    'fastfetch.jsonc'
    'kcm-about-distrorc'
    'kdeglobals'
    'jupiter-branding-apply'
    'jupiter-branding.hook'
    'wallpaper.png'
    'wallpaper-preview.png'
    'wallpaper-metadata.json'
)
sha256sums=('0c52812fa1b9ab61f8f6a58d78d22d2e6e901e80a83c4edb9c2f0bdfb05e1694'
            '25fdd93dbdb26769d3f477fd0179e27b5534d0662754a468255a9dc32d736ef1'
