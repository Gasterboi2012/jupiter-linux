            '811a54e708cff8626d95864fdb5b77d23e434973e21cb4c923f54ba1583a7f6c'
            '011258c5eba3dde0bb7a3426ffdfe43fd7713f8fc0511ad836a7f3fe56dba54a'
            '439f79e5d8fbcd39c88b76d9e68257cdf3e0b875bfe0525ef873a95fbea4a6d7'
            'f3cf02f3a5f8bb18269aacc008a266b6028538410ae3024af903d439cd4b9c40')

package() {
    # os-release and /etc/issue belong to the Arch "filesystem" package, so
    # they are staged in /usr/lib/jupiter and applied by the scriptlet and by
    # a pacman hook (see jupiter-branding-apply).
    install -Dm644 "${srcdir}/os-release" "${pkgdir}/usr/lib/jupiter/os-release"
    install -Dm644 "${srcdir}/issue" "${pkgdir}/usr/lib/jupiter/issue"
    install -Dm644 "${srcdir}/lsb-release" "${pkgdir}/etc/lsb-release"
    install -Dm755 "${srcdir}/jupiter-branding-apply" "${pkgdir}/usr/bin/jupiter-branding-apply"
    install -Dm644 "${srcdir}/jupiter-branding.hook" \
        "${pkgdir}/usr/share/libalpm/hooks/jupiter-branding.hook"

    # Artwork. os-release sets LOGO=jupiter-logo, which resolves through the
    # hicolor icon theme; KInfoCenter and the Plasma About page use it.
    install -Dm644 "${srcdir}/logo.svg" \
        "${pkgdir}/usr/share/icons/hicolor/scalable/apps/jupiter-logo.svg"
    install -Dm644 "${srcdir}/logo.svg" "${pkgdir}/usr/share/pixmaps/jupiter-logo.svg"
    install -Dm644 "${srcdir}/logo-256.png" \
        "${pkgdir}/usr/share/icons/hicolor/256x256/apps/jupiter-logo.png"
    install -Dm644 "${srcdir}/logo-512.png" \
        "${pkgdir}/usr/share/icons/hicolor/512x512/apps/jupiter-logo.png"
    install -Dm644 "${srcdir}/logo.txt" "${pkgdir}/usr/share/jupiter/branding/logo.txt"

    # KInfoCenter "About this System" (also shown in System Settings):
    # /etc/xdg/kcm-about-distrorc names the logo and the project website.
    install -Dm644 "${srcdir}/logo.svg" "${pkgdir}/usr/share/about-distro/jupiter-logo.svg"
    install -Dm644 "${srcdir}/kcm-about-distrorc" "${pkgdir}/etc/xdg/kcm-about-distrorc"

    # System-wide fastfetch look, used until the user writes their own config.
    install -Dm644 "${srcdir}/fastfetch.jsonc" "${pkgdir}/etc/fastfetch/config.jsonc"

    # Desktop defaults. Anything in the user's own config still wins.
    install -Dm644 "${srcdir}/kdeglobals" "${pkgdir}/etc/xdg/kdeglobals"

    # Wallpaper, offered in System Settings.
    install -Dm644 "${srcdir}/wallpaper.png" \
        "${pkgdir}/usr/share/wallpapers/Jupiter/contents/images/2560x1440.png"
    install -Dm644 "${srcdir}/wallpaper-preview.png" \
        "${pkgdir}/usr/share/wallpapers/Jupiter/contents/screenshot.png"
    install -Dm644 "${srcdir}/wallpaper-metadata.json" \
        "${pkgdir}/usr/share/wallpapers/Jupiter/metadata.json"
}
