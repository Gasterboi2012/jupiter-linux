#!/usr/bin/env bash
# Stand-ins for the privileged commands the installer runs.
#
# The script is installed under several names; its basename selects the
# behavior. Everything is logged to $STUB_LOG so tests can assert on it.

set -euo pipefail

command_name=$(basename -- "$0")

log_call() {
    printf '%s %s\n' "${command_name}" "$*" >>"${STUB_LOG:?}"
}

if [[ ${STUB_FAIL:-} == "${command_name}" ]]; then
    log_call "simulated failure"
    exit 1
fi

case ${command_name} in
    pacstrap)
        log_call "$@"
        # Pretend the base system landed in the target root.
        install -d "${JUPITER_MNT:?}/etc" "${JUPITER_MNT}/root" "${JUPITER_MNT}/var/log"
        ;;
    genfstab)
        printf 'UUID=%s / ext4 rw,relatime 0 1\n' "${TEST_ROOT_UUID:-TEST-UUID}"
        ;;
    arch-chroot)
        log_call "$@"
        target="${1:?}${2:?}"
        [[ -f ${target} ]] || {
            printf 'arch-chroot stub: missing %s\n' "${target}" >&2
            exit 3
        }
        bash -n "${target}"
        cp "${target}" "${POST_SCRIPT_COPY:?}"
        ;;
    blkid)
        printf '%s\n' "${TEST_ROOT_UUID:-TEST-UUID}"
        ;;
    mount)
        log_call "$@"
        touch "${MOUNT_MARKER:?}"
        ;;
    umount)
        log_call "$@"
        rm -f "${MOUNT_MARKER:?}"
        ;;
    mountpoint)
        [[ -e ${MOUNT_MARKER:?} ]]
        ;;
    lspci)
        printf '%s\n' "${LSPCI_FIXTURE:-}"
        ;;
    ping)
        [[ -e ${ONLINE_FILE:?} ]]
        ;;
    getent)
        case ${1:-} in
            passwd) exit 2 ;;
            ahostsv4) [[ -e ${ONLINE_FILE:?} ]] && exit 0 || exit 2 ;;
            *) exit 2 ;;
        esac
        ;;
    reboot | poweroff)
        log_call "would reboot/power off"
        ;;
    sync)
        ;;
    findmnt)
        exit 1
        ;;
    sgdisk | partprobe | udevadm | wipefs | mkfs.fat | mkfs.ext4)
        log_call "$@"
        ;;
    *)
        log_call "$@"
        ;;
esac
