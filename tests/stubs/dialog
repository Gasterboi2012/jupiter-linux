#!/usr/bin/env python3
"""Scriptable stand-in for dialog(1).

Responses come from the JSON array named by $DIALOG_SCRIPT. Each prompt
pops one entry: a string is returned as the selection, {"cancel": true}
behaves like Esc/Cancel, and "" dismisses a message box.

Every invocation is appended to $DIALOG_LOG as a JSON array, so tests can
assert what the user saw.
"""

import json
import os
import sys

BOXES = (
    "--gauge",
    "--yesno",
    "--msgbox",
    "--menu",
    "--inputbox",
    "--passwordbox",
    "--infobox",
    "--textbox",
    "--checklist",
    "--radiolist",
)

args = sys.argv[1:]
log_path = os.environ.get("DIALOG_LOG")
if log_path:
    with open(log_path, "a", encoding="utf-8") as handle:
        handle.write(json.dumps(args) + "\n")

box = next((name for name in BOXES if name in args), None)
if box is None:
    sys.exit(0)

if box in ("--gauge", "--infobox"):
    for _ in sys.stdin:
        pass
    sys.exit(0)

queue_path = os.environ["DIALOG_SCRIPT"]
with open(queue_path, encoding="utf-8") as handle:
    queue = json.load(handle)

if not queue:
    if box in ("--msgbox", "--infobox", "--textbox"):
        sys.exit(0)
    print("dialog stub: no response left for %s" % box, file=sys.stderr)
    sys.exit(2)

item = queue.pop(0)
with open(queue_path, "w", encoding="utf-8") as handle:
    json.dump(queue, handle)

if isinstance(item, dict):
    if item.get("cancel"):
        sys.exit(1)
    item = item.get("value", "")

if box == "--yesno":
    sys.exit(0 if str(item).lower() in ("yes", "ok") else 1)

if box in ("--msgbox", "--textbox"):
    sys.exit(0)

print(item)
sys.exit(0)
